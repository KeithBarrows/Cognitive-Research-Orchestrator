# Non-secret Plane settings. Secrets come from .NET User Secrets via up.cmd.
# CERT_ACME_CA must not be empty (proxy config breaks); it is unused on plain HTTP.
# Plane is reached at http://localhost:8090 (ports 80 and 443 are reserved
# for future projects, see CURRENT.md).
APP_RELEASE=v1.4.3
APP_DOMAIN=localhost:8090
WEB_URL=http://localhost:8090
CORS_ALLOWED_ORIGINS=http://localhost:8090
SITE_ADDRESS=:80
CERT_EMAIL=
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
CERT_ACME_DNS=
